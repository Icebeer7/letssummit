{
  "expo": {
    "name": "journime",
    "slug": "journime",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "reactnativefoundation",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/svgs/journime_logo.svg",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1E1335",
          "dark": {
            "backgroundColor": "#1E1335"
          }
        }
      ],
      "expo-mail-composer"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
